# Environment Configuration Example
APP_ENV=development

# Database Settings (SQLite for local dev, PostgreSQL for production/docker)
# SQLite dev: sqlite:///./database/security.db
# PostgreSQL docker: postgresql+psycopg://app:password@db:5432/hybrid_security
DATABASE_URL=sqlite:///./database/security.db

# JWT Authentication
JWT_SECRET=super-secret-cns-project-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Key Storage Paths
RSA_PRIVATE_KEY_PATH=./uploads/keys/rsa_private.pem
RSA_PUBLIC_KEY_PATH=./uploads/keys/rsa_public.pem

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50
STORAGE_ENCRYPTED_DIR=./uploads/encrypted_files
STORAGE_DECRYPTED_DIR=./uploads/decrypted_files

# CORS Settings
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080
